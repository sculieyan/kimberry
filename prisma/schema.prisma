generator client {
  provider = "prisma-client-js"
  // Default output (node_modules/@prisma/client) — Amplify's SSR compute
  // bundle ships node_modules but NOT arbitrary source dirs, so a custom
  // output path makes the query engine go missing at runtime.
  // Local dev runs on macOS (native); Amplify SSR runs on Amazon Linux 2023.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrderMetadata {
  id              Int    @id @default(autoincrement())

  // 订单号 — 订单的唯一业务标识（KB-YYYYMMDD-XXXXX），随邮件发送
  orderNumber     String  @unique @db.VarChar(32)

  // Stripe Checkout Session ID（cs_test_.../cs_live_...，demo 订单为 DEMO-*），用于支付对账
  stripeSessionId String? @db.VarChar(255)

  // 客户信息
  customerEmail   String? @db.VarChar(255)
  firstName       String? @db.VarChar(100)
  lastName        String? @db.VarChar(100)
  address         String? @db.VarChar(255)
  city            String? @db.VarChar(100)
  region          String? @db.VarChar(100)
  postcode        String? @db.VarChar(20)
  phone           String? @db.VarChar(50)

  // 物流信息
  shippingCode    String? @db.VarChar(50)
  shippingName    String? @db.VarChar(255)
  shippingPrice   Decimal? @db.Decimal(10,2)

  // 商品信息
  productName     String? @db.VarChar(255)
  productDetail   String? @db.Text
  productQty      Int?    @db.SmallInt
  productUnitPrice Decimal? @db.Decimal(10,2)

  // 时间戳
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @db.Timestamp(6)

  // 如果需要关联订单，开启下面，id根据你的Order模型调整
  // orderId     Int      @unique
  // order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_metadata")
}
